<Window x:Class="MilitaryDistrict.forms.EditPersonnelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MilitaryDistrict.forms"
        mc:Ignorable="d"
        Title="Редактирование персонала" MinHeight="100" MinWidth="500" SizeToContent="WidthAndHeight">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Имя:" Margin="10,0,0,5"/>
            <TextBox Text="{Binding first_name}" Margin="0,0,0,5"/>
            <TextBlock Text="Фамилия:" Margin="10,0,0,5"/>
            <TextBox Text="{Binding last_name}" Margin="0,0,0,5"/>
            <TextBlock Text="Отчество:" Margin="10,0,0,5"/>
            <TextBox Text="{Binding patronymic}" Margin="0,0,0,5"/>
            <TextBlock Text="Должность:" Margin="10,0,0,5"/>
            <TextBox Text="{Binding position}" Margin="0,0,0,5"/>
            <TextBlock Text="Звание:" Margin="10,0,0,5"/>
            <TextBox Text="{Binding rank}" Margin="0,0,0,5"/>
            <TextBlock Text="Дата рождения:" Margin="10,0,0,5"/>
            <DatePicker SelectedDate="{Binding birth_date}" Margin="0,0,0,5"/>
            <TextBlock Text="Дата зачисления:" Margin="10,0,0,5"/>
            <DatePicker SelectedDate="{Binding enlistment_date}" Margin="0,0,0,5"/>
            <TextBlock Text="Номер роты:" Margin="10,0,0,5"/>
            <ComboBox ItemsSource="{Binding companies.units.companies}" SelectedItem="{Binding companies}" DisplayMemberPath="id" Margin="0,0,0,5"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,10,0,0">
            <Button Name="SaveButton" Content="Сохранить" Click="SaveButton_Click" Margin="5"/>
            <Button Name="CancelButton" Content="Отмена" Click="CancelButton_Click" Margin="5"/>
        </UniformGrid>
    </Grid>
</Window>
