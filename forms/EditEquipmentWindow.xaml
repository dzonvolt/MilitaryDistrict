<Window x:Class="MilitaryDistrict.forms.EditEquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MilitaryDistrict.forms"
        mc:Ignorable="d"
        Title="Редактирование снаряжения" MinHeight="100" MinWidth="500" SizeToContent="WidthAndHeight">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Наименование:" Margin="10,0,0,5"/>
            <TextBox Text="{Binding name}" Margin="0,0,0,5"/>
            <TextBlock Text="Спецификация:" Margin="10,0,0,5"/>
            <TextBox Text="{Binding specs}" Margin="0,0,0,5"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,10,0,0">
            <Button Name="SaveButton" Content="Сохранить" Click="SaveButton_Click" Margin="5"/>
            <Button Name="CancelButton" Content="Отмена" Click="CancelButton_Click" Margin="5"/>
        </UniformGrid>
    </Grid>
</Window>
