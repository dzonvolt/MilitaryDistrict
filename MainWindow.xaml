<Window x:Class="MilitaryDistrict.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MilitaryDistrict"
        mc:Ignorable="d"
        Icon="/res/logo.ico"
        Title="SVO Manager" MinHeight="600" MinWidth="1100"
        FontFamily="Calibri" Loaded="MainWindow_Loaded">

    <Window.Resources>
        <Storyboard x:Key="MoveBackgroundAnimation">
            <DoubleAnimation 
                Storyboard.TargetName="BgTransform" 
                Storyboard.TargetProperty="Y"
                From="0" To="-300" 
                Duration="0:0:25"
                AutoReverse="True" 
                RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource MoveBackgroundAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Window.Background>
        <ImageBrush ImageSource="/res/background.jpg" 
                    Stretch="UniformToFill"
                    Viewport="0,0,1,1.5" 
                    ViewportUnits="RelativeToBoundingBox">
            <ImageBrush.Transform>
                <TranslateTransform x:Name="BgTransform" X="0" Y="0"/>
            </ImageBrush.Transform>
        </ImageBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Margin="5">
            <Image Source="/res/logo.png"/>
            <TextBlock Text="СВО-КОНТРОЛЬ" FontSize="30" FontFamily="Century Schoolbook" FontWeight="Bold" Margin="5" Foreground="White"/>
            <Image Source="/res/logo.png"/>
        </StackPanel>

        <Button Name="BackButton" Content="Назад" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5" Margin="10" Click="BackButton_Click" Visibility="Hidden"/>

        <Frame Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>

    </Grid>
</Window>
